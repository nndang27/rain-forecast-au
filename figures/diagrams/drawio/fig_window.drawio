<mxfile host="drawio"><diagram name="fig_window"><mxGraphModel grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Each box = the 31 scaled inputs of one day + 1 flag ('no record').&lt;br&gt;Day t is the day of the prediction (3:30 pm)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=17;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="0" width="1000" height="56" as="geometry"/></mxCell><mxCell id="n3" value="&lt;i&gt;prediction for day t&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=17;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="66" width="500" height="28" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;t-6&lt;/b&gt;&lt;br&gt;32 values" style="rounded=0;whiteSpace=wrap;html=1;fontSize=17;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="90" height="80" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;t-5&lt;/b&gt;&lt;br&gt;32 values" style="rounded=0;whiteSpace=wrap;html=1;fontSize=17;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="130" y="100" width="90" height="80" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;t-4&lt;/b&gt;&lt;br&gt;32 values" style="rounded=0;whiteSpace=wrap;html=1;fontSize=17;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="230" y="100" width="90" height="80" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;t-3&lt;/b&gt;&lt;br&gt;32 values" style="rounded=0;whiteSpace=wrap;html=1;fontSize=17;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="100" width="90" height="80" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;t-2&lt;/b&gt;&lt;br&gt;32 values" style="rounded=0;whiteSpace=wrap;html=1;fontSize=17;fontColor=#000000;fillColor=#dae8fc;strokeColor
<mxfile host="drawio"><diagram name="fig_system_overview"><mxGraphModel grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Training (done once, on 2008–2019 data)" style="swimlane;html=1;collapsible=0;startSize=34;rounded=0;dashed=1;fontSize=18;fontStyle=1;align=left;spacingLeft=10;swimlaneLine=0;fillColor=none;swimlaneFillColor=none;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="1250" height="330" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Raw data&lt;/b&gt;&lt;br&gt;&lt;br&gt;weatherAUS (rattle)&lt;br&gt;BOM daily readings&lt;br&gt;49 stations&lt;br&gt;2007 – Jan 2026&lt;br&gt;275,410 rows" style="rounded=0;whiteSpace=wrap;html=1;fontSize=17;fontColor=#000000;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="n2"><mxGeometry x="15" y="75" width="175" height="200" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Preprocessing&lt;/b&gt;&lt;br&gt;• timing check: drop RISK_MM, use&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;yesterday's MaxTemp, Sunshine, gust&lt;br&gt;• label: rain on day t+2 &amp;gt; 1 mm&lt;br&gt;• drop accumulated-rain labels&lt;br&gt;• median fill + 4 missing flags&lt;br&gt;• sin/cos for wind and month&lt;br&gt;• scaling (train statistics only)&lt;br&gt;• 7-day windows (GRU, Transformer)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=17;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="n2"><mxGeometry x="225" y="40" width="340" height="270" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Time split&lt;/b&gt;&lt;br&gt;&lt;br&gt;Train 2008–2019&lt;br&gt;Validation 2020–21&lt;br&gt;Test 2022 – Jan 2026" style="rounded=0;whiteSpace=wrap;html=1;fontSize=17;fontColor=#000000;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="n2"><mxGeometry x="640" y="95" width="175" height="160" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Train 5 models&lt;/b&gt;&lt;br&gt;&lt;br&gt;Logistic Regression&lt;br&gt;LightGBM&lt;br&gt;MLP, GRU&lt;br&gt;Transformer&lt;br&gt;&lt;i&gt;cross-entropy loss&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=17;fontColor=#000000;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="n2"><mxGeometry x="855" y="75" width="185" height="200" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Threshold&lt;/b&gt;&lt;br&gt;&lt;br&gt;chosen on&lt;br&gt;validation years&lt;br&gt;cost FN : FP = 3 : 1&lt;br&gt;→ 0.21 to 0.27" style="rounded=0;whiteSpace=wrap;html=1;fontSize=17;fontColor=#000000;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="n2"><mxGeometry x="1075" y="75" width="160" height="200" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontColor=#000000;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=16;labelBackgroundColor=#ffffff;" edge="1" parent="n2" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="264k&lt;br&gt;days" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontColor=#000000;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=16;labelBackgroundColor=#ffffff;" edge="1" parent="n2" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontColor=#000000;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=16;labelBackgroundColor=#ffffff;" edge="1" parent="n2" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontColor=#000000;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=16;labelBackgroundColor=#ffffff;" edge="1" parent="n2" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Saved:&lt;/b&gt; model + Prep statistics + threshold" style="rounded=0;whiteSpace=wrap;html=1;fontSize=17;fontColor=#000000;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="840" y="375" width="420" height="50" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontColor=#000000;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=16;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n7" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" value="Deployment (every day at 3:30 pm, for each station)" style="swimlane;html=1;collapsible=0;startSize=34;rounded=0;dashed=1;fontSize=18;fontStyle=1;align=left;spacingLeft=10;swimlaneLine=0;fillColor=none;swimlaneFillColor=none;strokeColor=#82b366;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="10" y="460" width="1250" height="300" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Today's BOM readings&lt;/b&gt;&lt;br&gt;&lt;br&gt;MinTemp, Rainfall&lt;br&gt;9 am and 3 pm readings&lt;br&gt;+ yesterday's MaxTemp,&lt;br&gt;Sunshine, wind gust" style="rounded=0;whiteSpace=wrap;html=1;fontSize=17;fontColor=#000000;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="n14"><mxGeometry x="15" y="70" width="215" height="190" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Same preprocessing&lt;/b&gt;&lt;br&gt;&lt;br&gt;saved train statistics&lt;br&gt;(no new fitting)&lt;br&gt;+ 7-day window" style="rounded=0;whiteSpace=wrap;html=1;fontSize=17;fontColor=#000000;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="n14"><mxGeometry x="275" y="80" width="200" height="170" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;Model&lt;/b&gt;&lt;br&gt;&lt;br&gt;probability p&lt;br&gt;e.g. &quot;30% chance&lt;br&gt;of rain&quot;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=17;fontColor=#000000;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="n14"><mxGeometry x="530" y="80" width="175" height="170" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;Decision&lt;/b&gt;&lt;br&gt;&lt;br&gt;p ≥ threshold → RAIN&lt;br&gt;p &amp;lt; threshold → NO RAIN&lt;br&gt;for 9 am day t+1&lt;br&gt;to 9 am day t+2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=17;fontColor=#000000;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="n14"><mxGeometry x="790" y="70" width="225" height="190" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Monitoring&lt;/b&gt;&lt;br&gt;&lt;br&gt;recall on heavy rain,&lt;br&gt;Brier score,&lt;br&gt;calibration&lt;br&gt;→ retrain if it drops" style="rounded=0;whiteSpace=wrap;html=1;fontSize=17;fontColor=#000000;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;dashed=1;" vertex="1" parent="n14"><mxGeometry x="1055" y="70" width="180" height="190" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontColor=#000000;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=16;labelBackgroundColor=#ffffff;" edge="1" parent="n14" source="n15" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontColor=#000000;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=16;labelBackgroundColor=#ffffff;" edge="1" parent="n14" source="n16" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="&amp;lt; 2 ms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontColor=#000000;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=16;labelBackgroundColor=#ffffff;" edge="1" parent="n14" source="n17" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontColor=#000000;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=16;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#666666;" edge="1" parent="n14" source="n18" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontColor=#000000;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=16;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="n12" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontColor=#000000;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=16;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="n12" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontColor=#000000;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=16;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="n12" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>